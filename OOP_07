class Book:
    def __init__(self,title,author,price):
        self.title = title
        self.author = author
        self.price = price


    def show_book(self):
        print("Title : ",self.title)
        print("Author : ",self.author)
        print("Price : ",self.price)



b1 = Book("Atomic Habits","James Clear",499)


b1.show_book()        
